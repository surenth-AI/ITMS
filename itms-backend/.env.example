# Copy this file to .env and fill in the values. Never commit .env.

# Required. Signs login tokens. At least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 = development auto-reload and debugger. Must be 0 outside your own machine.
FLASK_DEBUG=0
PORT=5000

# Optional. Defaults to the local SQLite file itms-backend/itms.db
# DATABASE_URL=postgresql://user:password@host:5432/itms
